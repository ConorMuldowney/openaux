{
  "name": "openaux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint . --max-warnings=0 && npm run check:domain-language && npm run check:ui-conventions",
    "typecheck": "tsc --noEmit",
    "typecheck:changed": "pwsh -Command \"& .\\scripts\\typecheck-changed.ps1 develop || exit $LASTEXITCODE\"",
    "check:domain-language": "node ./scripts/check-domain-language.mjs",
    "check:ui-conventions": "node ./scripts/check-ui-conventions.mjs",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.26.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.9.0",
    "@sentry/node": "^10.57.0",
    "@shadcn/react": "^0.3.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "22.14.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^16.6.1",
    "eslint": "9.23.0",
    "eslint-config-next": "^16.2.7",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "postcss": "8.5.3",
    "prisma": "^6.9.0",
    "shadcn": "^4.11.0",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.7.0",
    "typescript": "5.8.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  }
}
